{
  "name": "stagecraft-studio",
  "version": "0.1.0",
  "description": "A production layer for turning source articles into code-rendered educational motion graphics",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run check:agents && npm test && npm run build",
    "qa": "tsx scripts/qa.ts",
    "contact-sheet": "tsx scripts/contact-sheet.ts",
    "handoff": "tsx scripts/handoff.ts",
    "tts": "tsx scripts/generate-voice.ts",
    "render:pilot": "tsx scripts/render-pilot.ts",
    "check:agents": "tsx scripts/check-agent-env.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerrcass/stagecraft-studio.git"
  },
  "homepage": "https://github.com/gerrcass/stagecraft-studio#readme",
  "bugs": {
    "url": "https://github.com/gerrcass/stagecraft-studio/issues"
  },
  "keywords": [
    "motion-graphics",
    "explainer",
    "stagecraft",
    "opencode",
    "video"
  ],
  "author": "gerrcass",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
